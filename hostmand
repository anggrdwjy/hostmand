#!/bin/bash

DB_DIR="$HOME/.hostname_manager"
DB_FILE="$DB_DIR/hosts.csv"
BACKUP_DIR="$DB_DIR/backups"
SSH_CONFIG="$HOME/.ssh/config"

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
CYAN='\033[0;36m'
NC='\033[0m'

init_db() {
  mkdir -p "$DB_DIR"
  mkdir -p "$BACKUP_DIR"
  mkdir -p "$HOME/.ssh"
  if [ ! -f "$DB_FILE" ]; then
    echo "name,ip,user,description,bastion,port" > "$DB_FILE"
  else
    # Migrate old header: nama,ip,user,deskripsi,bastion -> new format
    local header=$(head -n 1 "$DB_FILE")
    if [[ "$header" == "nama,ip,user,deskripsi,bastion" ]] || [[ "$header" == "name,ip,user,description,bastion" ]]; then
      # Rewrite file with port 22 added
      local tmp="$DB_FILE.mig"
      echo "name,ip,user,description,bastion,port" > "$tmp"
      tail -n +2 "$DB_FILE" | while IFS=, read -r n i u d b p; do
        if [ -z "$p" ]; then p="22"; fi
        echo "$n,$i,$u,$d,$b,$p" >> "$tmp"
      done
      mv "$tmp" "$DB_FILE"
    fi
    # If old file has only 5 columns per line, add port 22
    if grep -qv ",.*,.*,.*,.*,.*," "$DB_FILE" 2>/dev/null; then
      local tmp2="$DB_FILE.mig2"
      head -n 1 "$DB_FILE" > "$tmp2"
      # Ensure header is new format
      sed -i '1s/.*/name,ip,user,description,bastion,port/' "$tmp2"
      tail -n +2 "$DB_FILE" | while IFS=, read -r n i u d b p; do
        if [ -z "$p" ]; then p="22"; fi
        echo "$n,$i,$u,$d,$b,$p" >> "$tmp2"
      done
      mv "$tmp2" "$DB_FILE"
    fi
  fi
}

auto_backup() {
  local reason="${1:-auto}"
  mkdir -p "$BACKUP_DIR"
  local ts=$(date +%Y%m%d-%H%M%S)
  cp "$DB_FILE" "$BACKUP_DIR/hosts-$ts-$reason.csv" 2>/dev/null
  # Keep only last 20 backups
  ls -t "$BACKUP_DIR"/hosts-*.csv 2>/dev/null | tail -n +21 | xargs -r rm -f
}

show_help() {
  echo -e "${CYAN}=== HOSTMAND - HOSTNAME MANAGER DAEMON ===${NC}"
  echo "Save & manage all your lab server hostnames"
  echo ""
  echo "Usage:"
  echo "  hostmand add <name> <ip> [user] [description] [bastion] [port]"
  echo "  hostmand list"
  echo "  hostmand search <keyword>"
  echo "  hostmand connect <name>     /  hostmand ssh <name>"
  echo "  hostmand ping <name>"
  echo "  hostmand del <name>"
  echo "  hostmand edit               (open csv file in nano)"
  echo "  hostmand export-ssh         (generate to ~/.ssh/config)"
  echo "  hostmand import-hosts       (import from /etc/hosts)"
  echo "  hostmand backup             (create backup now)"
  echo "  hostmand backup list        (list backups)"
  echo "  hostmand backup restore <file> (restore from backup)"
  echo "  hostmand add-bulk <file>    (add many hosts from text file)"
  echo "  hostmand sync <target>      (push hosts.csv to target)"
  echo "  hostmand sync --pull <target> (pull hosts.csv from target)"
  echo "  hostmand daemon             (check persistence after reboot)"
  echo "  hostmand clear              (delete all data)"
  echo ""
  echo "Examples:"
  echo "  hostmand add bastion localhost student Entry-point - 2222"
  echo "  hostmand add node1 10.0.0.11 student RHCSA-Lab bastion 22"
  echo "  hostmand add web1 192.168.1.50 ubuntu Web-server - 2222"
  echo "  hostmand list"
  echo "  hostmand connect node1"
  echo "  hostmand backup"
  echo "  hostmand add-bulk hosts.txt"
  echo "  hostmand sync workstation"
  echo ""
  echo "Data stored in: $DB_FILE"
  echo "Backups in: $BACKUP_DIR"
}

cmd_add() {
  local nama="$1" ip="$2" user="$3" deskripsi="$4" bastion="$5" port="$6"
  if [ -z "$nama" ]; then read -p "Hostname name (e.g: node1): " nama; fi
  if [ -z "$ip" ]; then read -p "IP / Host (e.g: 10.0.0.11): " ip; fi
  if [ -z "$user" ]; then read -p "SSH User [student]: " user; user=${user:-student}; fi
  if [ -z "$deskripsi" ]; then read -p "Description: " deskripsi; fi
  if [ -z "$bastion" ]; then read -p "Via which bastion? (bastion name / - if direct): " bastion; bastion=${bastion:--}; fi
  if [ -z "$port" ]; then read -p "SSH Port [22]: " port; port=${port:-22}; fi

  if [ -z "$nama" ] || [ -z "$ip" ]; then
    echo -e "${RED}Name and IP are required!${NC}"
    exit 1
  fi
  if ! [[ "$port" =~ ^[0-9]+$ ]]; then
    echo -e "${RED}Port must be a number, e.g. 22 or 2222${NC}"
    exit 1
  fi

  if grep -q "^$nama," "$DB_FILE"; then
    echo -e "${YELLOW}Hostname '$nama' already exists. Use another name or delete first: hostmand del $nama${NC}"
    exit 1
  fi

  auto_backup "before-add-$nama"
  deskripsi=$(echo "$deskripsi" | tr ',' ' ')
  echo "$nama,$ip,$user,$deskripsi,$bastion,$port" >> "$DB_FILE"
  echo -e "${GREEN}Success! Host '$nama' ($ip:$port) saved.${NC}"
}

cmd_list() {
  if [ ! -s "$DB_FILE" ] || [ "$(wc -l < "$DB_FILE")" -le 1 ]; then
    echo -e "${YELLOW}No hostnames saved yet. Add one first: hostmand add node1 10.0.0.11${NC}"
    return
  fi
  echo -e "${CYAN}Saved Hostnames List:${NC}"
  printf "%-20s %-20s\n" "IP ADDRESS" "HOSTNAME"
  echo "----------------------------------------"
  tail -n +2 "$DB_FILE" | while IFS=, read -r nama ip user deskripsi bastion port; do
    if [ -z "$port" ]; then port="22"; fi
    printf "%-20s %-20s\n" "$ip" "$nama"
  done
  echo "----------------------------------------"
  echo "Total: $(($(wc -l < "$DB_FILE") - 1)) host"
}

cmd_search() {
  local key="$1"
  if [ -z "$key" ]; then read -p "Search: " key; fi
  echo -e "${CYAN}Search results for '$key':${NC}"
  grep -i "$key" "$DB_FILE" | grep -v "^name," | while IFS=, read -r nama ip user deskripsi bastion port; do
    if [ -z "$port" ]; then port="22"; fi
    echo -e "  ${GREEN}$nama${NC} -> $ip:$port (user: $user, via: $bastion) - $deskripsi"
  done
}

get_host() {
  grep "^$1," "$DB_FILE" | head -n 1
}

# Helper: build ssh command parts for a host line
# Returns: user@ip -p port + optional -J bastion
cmd_connect() {
  local nama="$1"
  if [ -z "$nama" ]; then
    echo "Choose host to connect:"
    cmd_list
    read -p "Host name: " nama
  fi
  local line=$(get_host "$nama")
  if [ -z "$line" ]; then
    echo -e "${RED}Host '$nama' not found. Check with: hostmand list${NC}"
    exit 1
  fi
  IFS=, read -r h_nama h_ip h_user h_desc h_bastion h_port <<< "$line"
  if [ -z "$h_port" ]; then h_port="22"; fi
  echo -e "${CYAN}Connecting to $h_nama ($h_ip:$h_port) as $h_user...${NC}"
  if [ "$h_bastion" != "-" ] && [ -n "$h_bastion" ]; then
    local b_line=$(get_host "$h_bastion")
    if [ -n "$b_line" ]; then
      IFS=, read -r b_nama b_ip b_user b_desc b_bastion b_port <<< "$b_line"
      if [ -z "$b_port" ]; then b_port="22"; fi
      echo "Via bastion: $b_nama ($b_ip:$b_port)"
      ssh -p "$h_port" -J "$b_user@$b_ip:$b_port" "$h_user@$h_ip"
    else
      echo -e "${YELLOW}Bastion '$h_bastion' not found in database, trying direct + ProxyJump using bastion name.${NC}"
      ssh -p "$h_port" -J "$h_bastion" "$h_user@$h_ip"
    fi
  else
    ssh -p "$h_port" "$h_user@$h_ip"
  fi
}

cmd_ping() {
  local nama="$1"
  if [ -z "$nama" ]; then read -p "Which host to ping: " nama; fi
  local line=$(get_host "$nama")
  if [ -z "$line" ]; then echo -e "${RED}Host not found${NC}"; exit 1; fi
  IFS=, read -r h_nama h_ip h_user h_desc h_bastion h_port <<< "$line"
  echo "Pinging $h_nama ($h_ip)..."
  ping -c 4 "$h_ip"
}

cmd_del() {
  local nama="$1"
  if [ -z "$nama" ]; then read -p "Which host to delete: " nama; fi
  if ! grep -q "^$nama," "$DB_FILE"; then echo -e "${RED}Host not found${NC}"; exit 1; fi
  auto_backup "before-del-$nama"
  grep -v "^$nama," "$DB_FILE" > "$DB_FILE.tmp" && mv "$DB_FILE.tmp" "$DB_FILE"
  echo -e "${GREEN}Host '$nama' deleted. Backup created.${NC}"
}

cmd_export_ssh() {
  echo -e "${CYAN}Generating ~/.ssh/config from database...${NC}"
  cp "$SSH_CONFIG" "$SSH_CONFIG.bak" 2>/dev/null
  if [ -f "$SSH_CONFIG" ]; then
    awk 'BEGIN{skip=0} /# BEGIN HOSTMAND/{skip=1} /# END HOSTMAND/{skip=0; next} !skip{print}' "$SSH_CONFIG" > "$SSH_CONFIG.tmp" && mv "$SSH_CONFIG.tmp" "$SSH_CONFIG"
  fi
  {
    echo ""
    echo "# BEGIN HOSTMAND - do not edit manually, use hostmand export-ssh"
    tail -n +2 "$DB_FILE" | while IFS=, read -r nama ip user deskripsi bastion port; do
      if [ -z "$port" ]; then port="22"; fi
      echo "Host $nama"
      echo "  HostName $ip"
      echo "  User $user"
      echo "  Port $port"
      if [ "$bastion" != "-" ] && [ -n "$bastion" ]; then
        # If bastion has custom port, include it in ProxyJump
        local b_line=$(grep "^$bastion," "$DB_FILE" | head -n 1)
        if [ -n "$b_line" ]; then
          IFS=, read -r b_n b_ip b_user b_d b_b b_port <<< "$b_line"
          if [ -z "$b_port" ]; then b_port="22"; fi
          echo "  ProxyJump $b_user@$b_ip:$b_port"
        else
          echo "  ProxyJump $bastion"
        fi
      fi
      echo ""
    done
    echo "# END HOSTMAND"
  } >> "$SSH_CONFIG"
  echo -e "${GREEN}Success! Now you can directly use: ssh node1${NC}"
  echo "Old config backed up to: $SSH_CONFIG.bak"
}

cmd_import_hosts() {
  echo "Importing from /etc/hosts..."
  local count=0
  auto_backup "before-import"
  while read -r ip nama rest; do
    [[ "$ip" =~ ^#.*$ ]] && continue
    [[ -z "$ip" || -z "$nama" ]] && continue
    [[ "$nama" == "localhost" ]] && continue
    if ! grep -q "^$nama," "$DB_FILE"; then
      echo "$nama,$ip,student,Imported from /etc/hosts,-,22" >> "$DB_FILE"
      echo "  + $nama ($ip:22)"
      count=$((count+1))
    fi
  done < /etc/hosts
  echo -e "${GREEN}Done, $count new hosts added.${NC}"
}

cmd_backup() {
  local sub="$1" file="$2"
  mkdir -p "$BACKUP_DIR"
  case "$sub" in
    list|ls)
      echo -e "${CYAN}Backups in $BACKUP_DIR:${NC}"
      ls -lt "$BACKUP_DIR"/hosts-*.csv 2>/dev/null | awk '{print $9, $6, $7, $8}'
      if [ -z "$(ls "$BACKUP_DIR"/hosts-*.csv 2>/dev/null)" ]; then
        echo "No backups yet. Run: hostmand backup"
      fi
      ;;
    restore)
      if [ -z "$file" ]; then
        echo "Usage: hostmand backup restore <backup-file>"
        echo "Available backups:"
        ls -1 "$BACKUP_DIR" | head -n 20
        exit 1
      fi
      local src=""
      if [ -f "$file" ]; then src="$file";
      elif [ -f "$BACKUP_DIR/$file" ]; then src="$BACKUP_DIR/$file";
      else echo -e "${RED}Backup file not found: $file${NC}"; exit 1; fi
      auto_backup "before-restore"
      cp "$src" "$DB_FILE"
      echo -e "${GREEN}Restored from $src${NC}"
      cmd_list
      ;;
    ""|create|now)
      auto_backup "manual"
      local latest=$(ls -t "$BACKUP_DIR"/hosts-*.csv 2>/dev/null | head -n 1)
      echo -e "${GREEN}Backup created: $latest${NC}"
      ;;
    *)
      echo "Usage: hostmand backup [list|restore <file>]"
      ;;
  esac
}

cmd_add_bulk() {
  local file="$1"
  if [ -z "$file" ]; then
    echo "Usage: hostmand add-bulk <file>"
    echo ""
    echo "File format (CSV, one host per line):"
    echo "  name,ip,user,description,bastion,port"
    echo "  node1,10.0.0.11,student,RHCSA Lab,bastion,22"
    echo "  web1,192.168.1.50,ubuntu,Web server,-,2222"
    echo "  # lines starting with # are ignored"
    echo "  # port is optional, default 22"
    echo ""
    echo "Example file hosts.txt:"
    echo "  node1,10.0.0.11,student,RHCSA Lab,bastion,22"
    echo "  node2,10.0.0.12,student,RHCSA Lab,bastion,22"
    echo "  db1,10.0.0.20,root,DB server,bastion,2222"
    exit 1
  fi
  if [ ! -f "$file" ]; then echo -e "${RED}File not found: $file${NC}"; exit 1; fi
  auto_backup "before-bulk"
  local added=0 skipped=0 failed=0
  while IFS= read -r line || [ -n "$line" ]; do
    # Trim
    line=$(echo "$line" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
    [[ -z "$line" ]] && continue
    [[ "$line" =~ ^# ]] && continue
    [[ "$line" == "name,ip,user"* ]] && continue
    IFS=, read -r nama ip user deskripsi bastion port <<< "$line"
    # Trim spaces
    nama=$(echo "$nama" | xargs); ip=$(echo "$ip" | xargs); user=$(echo "$user" | xargs)
    deskripsi=$(echo "$deskripsi" | xargs); bastion=$(echo "$bastion" | xargs); port=$(echo "$port" | xargs)
    if [ -z "$nama" ] || [ -z "$ip" ]; then echo -e "${YELLOW}Skip invalid line: $line${NC}"; failed=$((failed+1)); continue; fi
    if [ -z "$user" ]; then user="student"; fi
    if [ -z "$bastion" ]; then bastion="-"; fi
    if [ -z "$port" ]; then port="22"; fi
    if grep -q "^$nama," "$DB_FILE"; then echo -e "${YELLOW}Skip duplicate: $nama${NC}"; skipped=$((skipped+1)); continue; fi
    deskripsi=$(echo "$deskripsi" | tr ',' ' ')
    echo "$nama,$ip,$user,$deskripsi,$bastion,$port" >> "$DB_FILE"
    echo -e "${GREEN}Added: $nama ($ip:$port)${NC}"
    added=$((added+1))
  done < "$file"
  echo ""
  echo -e "${CYAN}Bulk done: $added added, $skipped skipped, $failed failed. Backup created.${NC}"
  cmd_list
}

cmd_sync() {
  local mode="push" target=""
  if [ "$1" == "--pull" ]; then mode="pull"; target="$2";
  elif [ "$1" == "--check" ]; then mode="check"; target="$2";
  else target="$1"; fi

  if [ -z "$target" ]; then
    echo "Usage:"
    echo "  hostmand sync <target>          # push local hosts.csv to target"
    echo "  hostmand sync --pull <target>   # pull hosts.csv from target"
    echo "  hostmand sync --check <target>  # compare local vs remote"
    echo ""
    echo "Example:"
    echo "  hostmand sync workstation"
    echo "  hostmand sync --pull bastion"
    exit 1
  fi

  local line=$(get_host "$target")
  if [ -z "$line" ]; then echo -e "${RED}Target '$target' not found. Check with: hostmand list${NC}"; exit 1; fi
  IFS=, read -r t_nama t_ip t_user t_desc t_bastion t_port <<< "$line"
  if [ -z "$t_port" ]; then t_port="22"; fi

  # Build SSH/SCP base with bastion if needed
  local ssh_base="ssh -p $t_port $t_user@$t_ip"
  local scp_base="scp -P $t_port"
  if [ "$t_bastion" != "-" ] && [ -n "$t_bastion" ]; then
    local b_line=$(get_host "$t_bastion")
    if [ -n "$b_line" ]; then
      IFS=, read -r b_n b_ip b_user b_d b_b b_port <<< "$b_line"
      if [ -z "$b_port" ]; then b_port="22"; fi
      ssh_base="ssh -p $t_port -J $b_user@$b_ip:$b_port $t_user@$t_ip"
      scp_base="scp -P $t_port -J $b_user@$b_ip:$b_port"
    fi
  fi

  if [ "$mode" == "check" ]; then
    echo "Comparing local vs remote ($target)..."
    echo "Local:"
    wc -l "$DB_FILE"
    echo "Remote:"
    $ssh_base "wc -l ~/.hostname_manager/hosts.csv 2>/dev/null || echo 'No file on remote'"
    echo ""
    echo "Remote hosts:"
    $ssh_base "cat ~/.hostname_manager/hosts.csv 2>/dev/null | head -n 20"
    exit 0
  fi

  if [ "$mode" == "push" ]; then
    echo -e "${CYAN}Pushing hosts.csv to $target ($t_ip:$t_port)...${NC}"
    auto_backup "before-sync-push-$target"
    # Ensure remote dir exists + backup remote file
    $ssh_base "mkdir -p ~/.hostname_manager/backups && cp ~/.hostname_manager/hosts.csv ~/.hostname_manager/backups/hosts-\$(date +%Y%m%d-%H%M%S)-before-sync.csv 2>/dev/null; mkdir -p ~/.hostname_manager"
    # SCP push - need to handle -J vs -P: use scp with -o ProxyJump if needed
    if [ "$t_bastion" != "-" ] && [ -n "$t_bastion" ]; then
      local b_line2=$(get_host "$t_bastion")
      IFS=, read -r b_n2 b_ip2 b_user2 b_d2 b_b2 b_port2 <<< "$b_line2"
      if [ -z "$b_port2" ]; then b_port2="22"; fi
      scp -P "$t_port" -o "ProxyJump $b_user2@$b_ip2:$b_port2" "$DB_FILE" "$t_user@$t_ip:~/.hostname_manager/hosts.csv"
    else
      scp -P "$t_port" "$DB_FILE" "$t_user@$t_ip:~/.hostname_manager/hosts.csv"
    fi
    if [ $? -eq 0 ]; then
      echo -e "${GREEN}Sync push success! Remote now has your hosts.${NC}"
      # Regenerate SSH config on remote
      $ssh_base "hostmand daemon 2>/dev/null || hostmand export-ssh 2>/dev/null || echo 'Run hostmand export-ssh on remote'"
    else
      echo -e "${RED}Sync push failed.${NC}"
    fi
  fi

  if [ "$mode" == "pull" ]; then
    echo -e "${CYAN}Pulling hosts.csv from $target ($t_ip:$t_port)...${NC}"
    auto_backup "before-sync-pull-$target"
    local tmp_pull="$DB_FILE.pull"
    if [ "$t_bastion" != "-" ] && [ -n "$t_bastion" ]; then
      local b_line3=$(get_host "$t_bastion")
      IFS=, read -r b_n3 b_ip3 b_user3 b_d3 b_b3 b_port3 <<< "$b_line3"
      if [ -z "$b_port3" ]; then b_port3="22"; fi
      scp -P "$t_port" -o "ProxyJump $b_user3@$b_ip3:$b_port3" "$t_user@$t_ip:~/.hostname_manager/hosts.csv" "$tmp_pull"
    else
      scp -P "$t_port" "$t_user@$t_ip:~/.hostname_manager/hosts.csv" "$tmp_pull"
    fi
    if [ $? -eq 0 ] && [ -f "$tmp_pull" ]; then
      cp "$tmp_pull" "$DB_FILE"
      rm -f "$tmp_pull"
      echo -e "${GREEN}Sync pull success! Local now matches $target.${NC}"
      cmd_export_ssh
    else
      echo -e "${RED}Sync pull failed or no file on remote.${NC}"
    fi
  fi
}

cmd_daemon() {
  echo "hostmand daemon: data is persistent in $DB_FILE"
  echo "Checking hosts..."
  cmd_list
  echo ""
  echo "Regenerating SSH config..."
  cmd_export_ssh
  echo "hostmand is ready after reboot."
}

cmd_clear() {
  read -p "Are you sure to delete ALL hostnames? type YES: " confirm
  if [ "$confirm" == "YES" ]; then
    auto_backup "before-clear"
    echo "name,ip,user,description,bastion,port" > "$DB_FILE"
    echo -e "${RED}All data deleted. Backup created.${NC}"
  else
    echo "Cancelled."
  fi
}

init_db
case "$1" in
  add) cmd_add "$2" "$3" "$4" "$5" "$6" "$7" ;;
  list|ls) cmd_list ;;
  search|find) cmd_search "$2" ;;
  connect|ssh|go) cmd_connect "$2" ;;
  ping) cmd_ping "$2" ;;
  del|delete|rm) cmd_del "$2" ;;
  edit) nano "$DB_FILE" ;;
  export-ssh) cmd_export_ssh ;;
  import-hosts) cmd_import_hosts ;;
  backup) cmd_backup "$2" "$3" ;;
  add-bulk|bulk) cmd_add_bulk "$2" ;;
  sync) cmd_sync "$2" "$3" ;;
  daemon|status) cmd_daemon ;;
  clear) cmd_clear ;;
  help|--help|-h|"") show_help ;;
  *) echo -e "${RED}Unknown command: $1${NC}"; show_help ;;
esac
